@CarCatalogApi_HostAddress = https://localhost:7025

GET {{CarCatalogApi_HostAddress}}/api/manufacturers
Accept: application/json

###

GET {{CarCatalogApi_HostAddress}}/api/manufacturers/1?includeModels=true
Accept: application/json

###

POST {{CarCatalogApi_HostAddress}}/api/manufacturers
Content-Type: application/json

{
  "name": "Ford",
  "country": "United States",
  "foundedYear": 1903
}

###

POST {{CarCatalogApi_HostAddress}}/api/manufacturers/1/models
Content-Type: application/json

{
  "name": "Impala",
  "yearFrom": 1958,
  "bodyType": "Sedan"
}

###

POST {{CarCatalogApi_HostAddress}}/api/manufacturers/1/models/1/submodels
Content-Type: application/json

{
  "name": "Stingray",
  "engineCode": "6.2L V8",
  "horsePower": 490
}
